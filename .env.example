# Copy to .env (git-ignored) before `docker compose up`. Every variable the stack reads.

# Static bearer tokens for the two API roles (design decision D6). Required, must differ.
# Generate real values with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NURSE_TOKEN=change-me-nurse
ADMIN_TOKEN=change-me-admin

# Shared secret the MCP server requires from its client (the agent). Required, any non-empty value.
MCP_TOKEN=change-me-mcp
# Host port that publishes the MCP server (container port is always 8001).
MCP_HOST_PORT=8001
# Tool-calling model the agent uses (compose points the agent at the ollama service).
# `python -m agent.agent PA-006 --model <tag>` overrides it for one run.
AGENT_MODEL=qwen2.5:3b-instruct-q4_K_M

# Host port that publishes HAPI (container port is always 8080).
HAPI_HOST_PORT=8080
# Host port that publishes the API (container port is always 8000).
API_HOST_PORT=8000
# JVM options for HAPI. No volume, so memory is the only resource that matters.
HAPI_JAVA_OPTS=-Xms512m -Xmx2g

# How the API authenticates to the FHIR server: none | bearer | smart.
# Compose pins the local stack to none; set these only when pointing at another server.
FHIR_AUTH_MODE=none
# FHIR_BASE_URL is set by compose to http://hapi:8080/fhir. Override for a host run.
FHIR_BASE_URL=http://localhost:8080/fhir
# FHIR_AUTH_MODE=bearer
FHIR_BEARER_TOKEN=
# FHIR_AUTH_MODE=smart (client-credentials grant)
FHIR_TOKEN_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_SCOPE=system/*.read
FHIR_TIMEOUT_SECONDS=10
# FHIR base URL a browser can open. The worksheet links every cited resource to it.
# Compose defaults it to http://localhost:${HAPI_HOST_PORT}/fhir.
FHIR_PUBLIC_BASE_URL=

# Location of the SQLite audit chain. Compose mounts a named volume at /data.
AUDIT_DB_PATH=audit/audit.db
# Directory holding policy, requests and bundles, and the policy file name inside it.
RESOURCES_DIR=resources
POLICY_FILE=policy_MP-SYN-021.json
# Second directory of request forms, searched after resources/requests. Compose defaults it
# to the Synthea eval set at /srv/eval/synthea_requests.
# EXTRA_REQUESTS_DIR=/srv/eval/synthea_requests
LOG_LEVEL=INFO

# Host port that publishes Ollama (container port is always 11434).
OLLAMA_HOST_PORT=11434
# Model tags the one-shot ollama-pull fetches into the ollama-data volume (space separated).
OLLAMA_PULL_MODELS=qwen2.5:3b-instruct-q4_K_M llama3.2:3b-instruct-q4_K_M
# Summary writer. Compose sets OLLAMA_URL to http://ollama:11434; unset means template only.
OLLAMA_URL=
# Default summary model, and the comma-separated extra models a nurse may pick per request
# (GET /catalog lists them; any other name is refused with 422). Each must be in
# OLLAMA_PULL_MODELS, or picking it falls back to the template summary.
SUMMARY_MODEL=llama3.2:3b-instruct-q4_K_M
SUMMARY_MODEL_CHOICES=qwen2.5:3b-instruct-q4_K_M
# Seconds before the API gives up on the model and serves the template summary.
SUMMARY_TIMEOUT_SECONDS=30
# Seconds each component probe in GET /ready and GET /health/details may take.
HEALTH_TIMEOUT_SECONDS=3
# MCP server health route the API probes in GET /health/details. Compose sets it; unset skips it.
MCP_HEALTH_URL=
