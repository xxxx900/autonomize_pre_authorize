# Copy to .env (git-ignored) before `docker compose up`. Every variable the stack reads.

# Static bearer tokens for the two API roles (design decision D6). Required, must differ.
# Generate real values with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NURSE_TOKEN=change-me-nurse
ADMIN_TOKEN=change-me-admin

# Shared secret the MCP server requires from its client (the agent). Required, any non-empty value.
MCP_TOKEN=change-me-mcp
# Host port that publishes the MCP server (container port is always 8001).
MCP_HOST_PORT=8001
# Ollama endpoint and tool-calling model the agent uses.
OLLAMA_URL=http://host.docker.internal:11434
AGENT_MODEL=qwen2.5:3b

# Host port that publishes HAPI (container port is always 8080).
HAPI_HOST_PORT=8080
# Host port that publishes the API (container port is always 8000).
API_HOST_PORT=8000
# JVM options for HAPI. No volume, so memory is the only resource that matters.
HAPI_JAVA_OPTS=-Xms512m -Xmx2g

# How the API authenticates to the FHIR server: none | bearer | smart.
# Compose pins the local stack to none; set these only when pointing at another server.
FHIR_AUTH_MODE=none
# FHIR_BASE_URL is set by compose to http://hapi:8080/fhir. Override for a host run.
FHIR_BASE_URL=http://localhost:8080/fhir
# FHIR_AUTH_MODE=bearer
FHIR_BEARER_TOKEN=
# FHIR_AUTH_MODE=smart (client-credentials grant)
FHIR_TOKEN_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_SCOPE=system/*.read
FHIR_TIMEOUT_SECONDS=10

# Location of the SQLite audit chain. Compose mounts a named volume at /data.
AUDIT_DB_PATH=audit/audit.db
# Directory holding policy, requests and bundles, and the policy file name inside it.
RESOURCES_DIR=resources
POLICY_FILE=policy_MP-SYN-021.json
LOG_LEVEL=INFO
